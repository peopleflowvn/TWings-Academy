# ---- Secrets: never commit ----
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.age
secrets/
.secrets/
infra/vps/*.env

# ---- Node / frontend ----
node_modules/
dist/
build/
coverage/
*.log

# ---- Python / backend ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3
backend/staticfiles/
backend/media/

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---- VPS env files: only *.example templates are tracked ----
infra/env/*.env

# ---- Moodle (lms/): tracked exactly as upstream ships it (Moodle's own lms/.gitignore still applies,
# e.g. lms/config.php). Without this, rules above such as build/ would hide Moodle's amd/build files.
!lms/**
