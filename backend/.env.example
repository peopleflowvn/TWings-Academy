# =============================================================================
# TWings backend environment – TEMPLATE ONLY. Copy to .env (local) or
# /opt/twings/env/backend.env (VPS) and fill in real values. Never commit the copy.
# Generate secrets with:  python backend/scripts/generate_secrets.py
# =============================================================================

# --- Django core -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production: a random path such as ops-<random>/ ; dev may keep admin/
DJANGO_ADMIN_URL=admin/
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Header with the visitor IP set by the reverse proxy. Production (behind Caddy): X-Real-IP.
# Leave empty when the app is reachable directly, otherwise the header could be spoofed.
REAL_IP_HEADER=

# --- Database ----------------------------------------------------------------
# Local dev can use SQLite: sqlite:///db.sqlite3
DATABASE_URL=postgres://twings_app:change-me@127.0.0.1:5432/twings

# --- Personal-data encryption (Fernet keys, comma-separated, newest first) ----
FIELD_ENCRYPTION_KEYS=change-me
BLIND_INDEX_KEY=change-me

# --- Cloudflare R2 (production only) ------------------------------------------
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=twings-media
# Public hostname of the media bucket (R2 "Public Development URL" pub-<id>.r2.dev, or a custom domain)
R2_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev
R2_PRIVATE_BUCKET=twings-private

# --- Resend email --------------------------------------------------------------
# Empty RESEND_API_KEY = sandbox mode (emails are logged as "simulated", not sent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TWings Academy <tuyensinh@example.com>
RESEND_WEBHOOK_SECRET=

# --- Bank transfer notifications (SePay-compatible webhook) -------------------
BANK_WEBHOOK_API_KEY=

# --- VietQR receiving account ---------------------------------------------------
VIETQR_BANK_BIN=970426
VIETQR_BANK_NAME=MSB
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=CONG TY CP TWINGS ACADEMY

# --- Moodle LMS + SSO (optional) -------------------------------------------------
# Internal URL of Moodle (Docker network) and its canonical public hostname
MOODLE_INTERNAL_URL=
MOODLE_HOST=
MOODLE_WS_TOKEN=
# OAuth2 provider for Moodle's "Đăng nhập bằng TWings" (empty secret = disabled)
SSO_CLIENT_ID=moodle
SSO_CLIENT_SECRET=
SSO_REDIRECT_URIS=
