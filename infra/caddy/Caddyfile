# TWings web container (baked into the web image, see infra/caddy/Dockerfile).
#
#   Internet ─HTTPS─▶ shared gateway (TLS) ─HTTP─▶ this container :8080 ─┬─▶ React site (WEB_DOMAIN)
#                                                                        └─▶ backend:8000 (API_DOMAIN)
#
# TLS terminates at the shared gateway on the VPS. WEB_DOMAIN and API_DOMAIN come from
# /opt/twings/env/caddy.env.
{
	auto_https off
	admin off
	servers {
		# Only the gateway (Docker private network) may supply X-Forwarded-For/Proto; anything a
		# visitor sends is replaced by the gateway, so {client_ip} below is the real visitor.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip
	header -Server

	# ------------------------------------------------------------ React site (+ same-origin API)
	# WEB_DOMAIN is the public site. TEST_DOMAIN (optional) serves the very same site for testing
	# from networks that cannot reach WEB_DOMAIN; it is kept out of search engines.
	@web host {$WEB_DOMAIN} {$TEST_DOMAIN:test.invalid}
	handle @web {
		@test host {$TEST_DOMAIN:test.invalid}
		header @test X-Robots-Tag "noindex, nofollow"
		# Staff CMS & CRM (SPA route /app): never indexed on any domain.
		@cms path /app /app/*
		header @cms X-Robots-Tag "noindex, nofollow"
		@testRobots {
			host {$TEST_DOMAIN:test.invalid}
			path /robots.txt
		}
		# Inside its own handle: a bare respond would run after the catch-all handle below.
		handle @testRobots {
			respond "User-agent: *
Disallow: /
" 200
		}

		# The SPA calls the API on its own origin (VITE_API_BASE_URL=same-origin): no CORS, and the
		# session cookie stays first-party on every domain the site is served from.
		handle /api/* {
			request_body {
				max_size 10MB
			}
			reverse_proxy backend:8000 {
				header_up X-Real-IP {client_ip}
			}
		}

		# Public certificate verification pages (rendered by Django).
		handle /xac-minh/* {
			reverse_proxy backend:8000 {
				header_up X-Real-IP {client_ip}
			}
		}

		# Moodle LMS. Its web service API is for the TWings backend only (internal network): never
		# reachable from the internet, so a leaked token is useless from outside.
		handle /learn* {
			@moodleWs path /learn/webservice/*
			respond @moodleWs 404
			header X-Robots-Tag "noindex, nofollow"
			request_body {
				max_size 256MB
			}
			reverse_proxy lms:8080
		}

		# Sitemap and robots.txt come from Django (the test domain answers its own robots.txt above).
		@seoFiles path /sitemap.xml /robots.txt
		handle @seoFiles {
			reverse_proxy backend:8000 {
				header_up X-Real-IP {client_ip}
			}
		}

		# Link-preview bots (Facebook, Messenger, Zalo, X, LinkedIn, Telegram...) never run the SPA's
		# JavaScript, and search engines index faster without it: they get the page's server-rendered
		# HTML (title, description, share image, canonical, structured data, main text). People always
		# get the SPA, which loads the same metadata from /api/v1/public/seo/.
		@bots {
			header_regexp User-Agent (?i)(facebookexternalhit|facebot|meta-externalagent|zalo|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|whatsapp|skypeuripreview|pinterest|redditbot|embedly|viber|googlebot|google-inspectiontool|bingbot|coccocbot|applebot|duckduckbot|yandex)
			not path /assets/* /api/* /app /app/* /learn* /xac-minh/* /favicon.ico
		}
		handle @bots {
			header Vary User-Agent
			rewrite * /_seo{path}
			reverse_proxy backend:8000 {
				header_up X-Real-IP {client_ip}
			}
		}

		handle {
			root * /srv/web
			header {
				Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
				Strict-Transport-Security "max-age=31536000"
				X-Content-Type-Options nosniff
				X-Frame-Options DENY
				Referrer-Policy strict-origin-when-cross-origin
				Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
				Cross-Origin-Opener-Policy same-origin
			}
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@pages not path /assets/*
			header @pages {
				Cache-Control "no-cache"
				# Same URL, different HTML for bots (see @bots): keep caches from mixing them up.
				Vary User-Agent
			}

			# Client-side routing: unknown paths get the SPA shell.
			try_files {path} /index.html
			file_server
		}
	}

	# ------------------------------------------------------------ API
	@api host {$API_DOMAIN}
	handle @api {
		request_body {
			max_size 10MB
		}

		# Uploaded images when R2 is not configured (shared read-only volume with the backend).
		handle_path /media/* {
			root * /srv/appdata/media
			header {
				X-Content-Type-Options nosniff
				Content-Security-Policy "default-src 'none'; sandbox"
				Cache-Control "public, max-age=86400"
			}
			file_server
		}

		handle {
			reverse_proxy backend:8000 {
				# Overwrite (never append): Django reads it via REAL_IP_HEADER=X-Real-IP for
				# throttling and login lockouts.
				header_up X-Real-IP {client_ip}
			}
		}
	}

	# Any other Host header: nothing here.
	handle {
		respond 404
	}

	# No access log here: gunicorn already logs requests without query strings (personal data).
}
