# /opt/twings/env/backup.env  (root:root, chmod 600)
# age public key (recipient). Keep the matching PRIVATE key offline – it is not needed on the VPS.
AGE_RECIPIENT=age1...
# rclone remote + bucket for encrypted dumps (objects go under postgres/ and moodle/) (R2 token scoped to this bucket only).
BACKUP_REMOTE=r2:twings-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
