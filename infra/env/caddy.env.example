# /opt/twings/env/caddy.env  (root:root, chmod 600) - public values, no secrets.
# DNS: A records for both names -> VPS public IP must exist before Caddy can obtain certificates.
WEB_DOMAIN=tuyensinh.twings.edu.vn
API_DOMAIN=api-tuyensinh.twings.edu.vn
# Optional second hostname serving the same site for testing (noindex, robots disallow)
TEST_DOMAIN=
# Extra hostnames that 301-redirect to WEB_DOMAIN (comma separated, no spaces; optional)
REDIRECT_DOMAINS=
