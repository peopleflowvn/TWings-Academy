# /opt/twings/env/db.env  (root:root, chmod 600)
POSTGRES_DB=twings
# Superuser used only by the postgres container itself and for backups.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random
# Non-superuser role Django connects with (created by postgres/init/01-app-role.sh).
APP_DB_USER=twings_app
APP_DB_PASSWORD=change-me-long-random
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
