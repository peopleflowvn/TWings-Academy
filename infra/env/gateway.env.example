# /opt/twings/env/gateway.env  (root:root, chmod 600) - the shared reverse proxy on this host.
# Host-specific, so the real values live only on the VPS and in the root .env (PROD_GATEWAY__*).
GATEWAY_NETWORK=<docker network the gateway container is attached to>
GATEWAY_CONTAINER=<gateway container name>
GATEWAY_FILE=<host path of the gateway's bind-mounted Caddyfile>
