# /opt/twings/env/lms.env  (root:root, chmod 600) - Moodle (infra/lms). Rendered from PROD_LMS__* in .env.
MOODLE_DB_HOST=db
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
# URL-safe characters only (deploy.sh creates the Postgres role with it)
MOODLE_DB_PASSWORD=
# Site hostnames serving /learn, comma separated; the first is canonical (cron, e-mail links)
MOODLE_HOSTS=tuyensinh.example.vn
# Moodle site administrator (username "admin"), used by the first install only
MOODLE_ADMIN_EMAIL=
MOODLE_ADMIN_PASSWORD=
# Required for any install/upgrade through the web UI (deploy.sh uses the CLI)
MOODLE_UPGRADE_KEY=
# SSO: Moodle's OAuth2 client for the TWings provider (= SSO_CLIENT_ID / SSO_CLIENT_SECRET in backend.env)
MOODLE_SSO_CLIENT_ID=moodle
MOODLE_SSO_CLIENT_SECRET=
# Web service token shared with the backend (MOODLE_WS_TOKEN in backend.env): 32 letters/digits
MOODLE_WS_TOKEN=
# Outgoing mail (e.g. Resend SMTP: smtp.resend.com:587, user "resend", password = API key)
MOODLE_SMTP_HOST=
MOODLE_SMTP_USER=
MOODLE_SMTP_PASSWORD=
MOODLE_NOREPLY_EMAIL=
