{{!
    @template theme_twings/core/email_html

    Every HTML e-mail Moodle sends, in the TWings frame (brand bar with logo, body, footer links).
    The backend uses the same frame (backend/apps/notifications/layout.py): keep both in step.

    Context variables: see core/email_html (body, sitewwwroot...).

    Example context (json):
    {
        "body": "<p>Chào An,</p>",
        "sitewwwroot": "https://tuyensinh.twings.edu.vn/learn"
    }
}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F5F9;padding:32px 12px;">
<tr><td align="center">
<!--[if mso]>
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center">
<tr><td>
<![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-container" style="max-width:600px;background:#ffffff;border:1px solid #E2E8F0;border-radius:16px;overflow:hidden;box-shadow:0 10px 25px rgba(15,23,42,0.06);">
  <!-- Brand Header Bar with Logo Monogram -->
  <tr>
    <td class="email-header" style="background:#0F172A;padding:24px 30px;border-radius:16px 16px 0 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td valign="middle" style="width:44px;">
            <!-- Brand Monogram Logo Badge -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" valign="middle" style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg, #00388A 0%, #0073C1 100%);color:#ffffff;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-weight:900;font-size:16px;text-align:center;box-shadow:0 4px 12px rgba(0, 115, 193, 0.4);">
                  TW
                </td>
              </tr>
            </table>
          </td>
          <td valign="middle" style="padding-left:14px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-weight:800;font-size:17px;line-height:1.2;color:#ffffff;letter-spacing:0.3px;">TWings Academy</td>
              </tr>
            </table>
            <div style="font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:10px;font-weight:600;color:#93C5FD;letter-spacing:0.8px;text-transform:uppercase;margin-top:3px;">
              Học Viện Đào Tạo Thực Chiến Tài Chính Ngân Hàng
            </div>
          </td>
          <td align="right" valign="middle">
            <span style="display:inline-block;padding:4px 10px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.18);border-radius:20px;font-family:'Plus Jakarta Sans',Segoe UI,Arial,sans-serif;font-size:10px;font-weight:700;color:#93C5FD;letter-spacing:0.5px;">
              TWINGS LMS
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Brand Accent Separator Line -->
  <tr>
    <td height="3" style="background:linear-gradient(90deg, #00388A 0%, #0073C1 50%, #38BDF8 100%);font-size:0;line-height:0;">&nbsp;</td>
  </tr>

  <!-- Content Body Area -->
  <tr>
    <td class="email-body" style="padding:32px 30px 24px 30px;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1E293B;font-size:14px;line-height:1.65;">
      {{{body}}}
    </td>
  </tr>

  <!-- Brand Footer -->
  <tr>
    <td class="email-footer" style="background:#F8FAFC;border-top:1px solid #E2E8F0;border-radius:0 0 16px 16px;padding:24px 30px;text-align:center;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <div style="font-size:12px;font-weight:700;margin-bottom:8px;color:#475569;">
        <a href="{{{sitewwwroot}}}/" style="color:#0056D2;text-decoration:none;font-weight:700;">Cổng học viên LMS</a> ·
        <a href="{{{sitewwwroot}}}/tai-khoan" style="color:#0056D2;text-decoration:none;font-weight:700;">Học phí &amp; hồ sơ</a> ·
        <a href="mailto:hello@twings.edu.vn" style="color:#0056D2;text-decoration:none;font-weight:700;">hello@twings.edu.vn</a>
      </div>
      <div style="font-size:11px;color:#94A3B8;line-height:1.6;margin-bottom:8px;">
        Trụ sở: Tòa nhà ROX Tower, 54A Nguyễn Chí Thanh, Q. Đống Đa, TP. Hà Nội<br>
        Hotline: 1900 633 898 / 0843 314 382 · Website: <a href="https://twings.edu.vn" style="color:#64748B;text-decoration:none;">twings.edu.vn</a>
      </div>
      <div style="font-size:10px;color:#CBD5E1;">
        &copy; 2026 TWings Academy. Bản quyền được bảo lưu. Email thông báo từ hệ thống học trực tuyến TWings LMS.
      </div>
    </td>
  </tr>
</table>
<!--[if mso]>
</td></tr>
</table>
<![endif]-->
</td></tr>
</table>
