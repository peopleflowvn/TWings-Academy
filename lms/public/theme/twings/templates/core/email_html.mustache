{{!
    @template theme_twings/core/email_html

    Every HTML e-mail Moodle sends, in the TWings frame (logo header, body, footer links).
    A static copy of the backend frame (backend/apps/notifications/layout.py): keep both in step.
    The logo is the one configured in /app/content/email (or the website logo), served through
    /api/v1/public/email-logo/; contact details that change (hotline) are not repeated here.

    Context variables: see core/email_html (body, sitewwwroot...).

    Example context (json):
    {
        "body": "<p>Chào An,</p>",
        "sitewwwroot": "https://tuyensinh.twings.edu.vn/learn"
    }
}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F5F9;">
<tr><td align="center" style="padding:28px 12px;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-container" style="max-width:600px;width:100%;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:14px;overflow:hidden;">
  <tr>
    <td height="4" style="background:#0056D2;font-size:0;line-height:0;">&nbsp;</td>
  </tr>
  <tr>
    <td style="padding:22px 32px 18px 32px;border-bottom:1px solid #E2E8F0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td valign="middle"><a href="https://twings.edu.vn/" style="text-decoration:none;"><img src="https://twings.edu.vn/api/v1/public/email-logo/" alt="TWings Academy" height="44" style="display:block;height:44px;width:auto;max-width:220px;border:0;outline:none;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:20px;font-weight:800;color:#0056D2;"></a></td>
          <td align="right" valign="middle" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;color:#64748B;line-height:1.4;">Hệ thống học trực tuyến TWings LMS</td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:30px 32px 28px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1E293B;font-size:15px;line-height:1.65;">
      {{{body}}}
    </td>
  </tr>
  <tr>
    <td style="background:#F8FAFC;border-top:1px solid #E2E8F0;padding:22px 32px;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <div style="font-size:12px;font-weight:700;margin-bottom:10px;">
        <a href="https://twings.edu.vn/" style="color:#0056D2;text-decoration:none;font-weight:700;">Website</a> &nbsp;·&nbsp;
        <a href="{{{sitewwwroot}}}/" style="color:#0056D2;text-decoration:none;font-weight:700;">Vào học (LMS)</a> &nbsp;·&nbsp;
        <a href="{{{sitewwwroot}}}/tai-khoan" style="color:#0056D2;text-decoration:none;font-weight:700;">Học phí &amp; hồ sơ</a>
      </div>
      <div style="font-size:11px;color:#94A3B8;line-height:1.6;">
        Email tự động từ hệ thống học trực tuyến TWings LMS. Cần hỗ trợ? Xem hotline và email liên hệ tại <a href="https://twings.edu.vn/" style="color:#64748B;">twings.edu.vn</a>.<br>
        &copy; TWings Academy.
      </div>
    </td>
  </tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
