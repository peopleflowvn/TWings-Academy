{{!
    This file is part of TWings Academy Moodle theme.
    @template core/loginform
    Modern glassmorphic login card matching /app/login design and UX.
}}
<div class="twings-login-card">
    <!-- Top Header: Brand & Role Badge -->
    <div class="twings-card-header">
        <a href="/" class="twings-brand-lockup" title="TWings Academy">
            <div class="twings-brand-icon">
                <span class="twings-brand-tw">TW</span>
                <span class="twings-brand-dot"></span>
            </div>
            <div class="twings-brand-text">
                <div class="twings-wordmark-title">TWINGS</div>
                <div class="twings-wordmark-sub">ACADEMY</div>
            </div>
        </a>

        <div class="twings-role-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
            <span>Cổng Học Viên LMS</span>
        </div>
    </div>

    <!-- Title & Subtitle -->
    <div class="twings-card-titles">
        <h2 class="card-title">Đăng nhập tài khoản</h2>
        <p class="card-subtitle">Nhập thông tin tài khoản học viên để truy cập không gian học tập trực tuyến.</p>
    </div>

    <!-- Maintenance Notice -->
    {{#maintenance}}
        <div class="twings-alert alert-warning mb-3" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="alert-icon">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <div>{{{maintenance}}}</div>
        </div>
    {{/maintenance}}

    <!-- Error Alert -->
    {{#error}}
        <div class="twings-alert alert-danger mb-3" id="loginerrormessage" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="alert-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
                {{#errortitle}}<strong style="display: block; margin-bottom: 2px;">{{errortitle}}</strong>{{/errortitle}}
                <span>{{error}}</span>
            </div>
        </div>
    {{/error}}

    <!-- Info Alert -->
    {{#info}}
        <div class="twings-alert alert-info mb-3" id="logininfomessage" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="alert-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <div>{{info}}</div>
        </div>
    {{/info}}

    <!-- Main Login Form (action /learn/login without .php) -->
    {{#showloginform}}
        <form class="twings-form" action="/learn/login" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <!-- Username / Email Field -->
            <div class="twings-field-group">
                <label for="username" class="twings-form-label">
                    {{^canloginbyemail}}
                        {{#str}} username {{/str}}
                    {{/canloginbyemail}}
                    {{#canloginbyemail}}
                        Tên đăng nhập hoặc Email học viên
                    {{/canloginbyemail}}
                </label>
                <div class="twings-input-wrapper">
                    <svg class="twings-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <input type="text"
                           name="username"
                           id="username"
                           class="twings-input"
                           value="{{username}}"
                           placeholder="tunglh.com@gmail.com"
                           autocomplete="username"
                           required>
                </div>
            </div>

            <!-- Password Field -->
            <div class="twings-field-group">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                    <label for="password" class="twings-form-label" style="margin-bottom: 0;">Mật khẩu</label>
                    <a href="/learn/login/forgot_password.php" class="twings-forgot-link">Quên mật khẩu?</a>
                </div>
                <div class="twings-input-wrapper">
                    <svg class="twings-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input type="password"
                           name="password"
                           id="password"
                           class="twings-input"
                           value=""
                           placeholder="••••••••••••"
                           autocomplete="current-password"
                           required>
                    <button type="button" class="twings-pw-toggle" id="twings-toggle-pwd" aria-label="Hiện hoặc ẩn mật khẩu">
                        <svg id="twings-eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Recaptcha if enabled -->
            {{#recaptcha}}
                <div class="twings-field-group recaptcha-wrapper">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}

            <!-- Submit Button -->
            <div style="margin-top: 24px; margin-bottom: 16px;">
                <button class="twings-submit-btn" type="submit" id="loginbtn">
                    <span>Đăng nhập vào lớp học</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </form>
    {{/showloginform}}

    <!-- Security Hint Box -->
    <div class="twings-security-hint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Tài khoản học viên được cấp tự động sau khi đăng ký khóa học. Nếu cần hỗ trợ kích hoạt, liên hệ Cố vấn học tập TWings.</span>
    </div>

    <!-- External IDPs (OAuth2 / SSO) -->
    {{#hasidentityproviders}}
        <div class="twings-divider"><span>hoặc đăng nhập bằng</span></div>
        <div class="twings-idp-list">
            {{#identityproviders}}
                <a class="twings-idp-btn" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="18" height="18" style="border-radius: 4px;"/>
                    {{/iconurl}}
                    <span>{{#str}}loginwith, core, {{name}}{{/str}}</span>
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}

    <!-- Guest Login if enabled -->
    {{#canloginasguest}}
        <div class="twings-divider"><span>hoặc</span></div>
        <form action="/learn/login" method="post" id="guestlogin" class="mb-3">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest" />
            <input type="hidden" name="password" value="guest" />
            <button class="twings-idp-btn" type="submit" id="loginguestbtn">
                <span>{{#str}}loginasguest{{/str}}</span>
            </button>
        </form>
    {{/canloginasguest}}

    <!-- Instructions / Sign up (if enabled) -->
    {{#hasinstructions}}
        <div class="twings-instructions mb-3">
            {{{instructions}}}
        </div>
    {{/hasinstructions}}
    {{#cansignup}}
        <div style="text-align: center; margin-bottom: 16px;">
            <a class="twings-forgot-link" href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
        </div>
    {{/cansignup}}

    <!-- Quick Links inside Card -->
    <div class="twings-quick-links">
        <div class="quick-links-row">
            <a href="/app/login" class="twings-quick-link" title="Dành cho Ban Quản trị & Giảng viên">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 2l-2 2m-1.5 1.5L16 7m-1.5 1.5L13 10m-1.5 1.5L10 13m-2-2l3.5-3.5a4.95 4.95 0 1 0-7 7L8 18l4-4"></path>
                </svg>
                <span>Cổng Quản trị /app</span>
            </a>
            <span class="dot-sep">•</span>
            <a href="/xac-minh/" class="twings-quick-link" title="Tra cứu Chứng chỉ số">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
                <span>Tra cứu Chứng chỉ</span>
            </a>
        </div>
        <div class="quick-links-row" style="margin-top: 4px;">
            <a href="/" class="twings-quick-link" title="Về trang chủ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Trang chủ</span>
            </a>
        </div>
    </div>

    <!-- Cookies Notice & Language Menu -->
    <div class="twings-card-footer">
        {{#languagemenu}}
            <div class="twings-lang-menu">
                {{>core/action_menu}}
            </div>
            <span class="dot-sep">•</span>
        {{/languagemenu}}
        <button type="button" class="twings-cookie-btn"
                data-modal="alert"
                data-modal-title-str='["cookiesenabled", "core"]'
                data-modal-content-str='["cookiesenabled_help_html", "core"]'>
            {{#str}}cookiesnotice{{/str}}
        </button>
    </div>
</div>

<!-- Outside Footer Copyright -->
<div class="twings-outer-copyright">
    <div>© 2026 TWings Academy. Nền tảng Đào tạo & Kỹ năng Số Thực Chiến.</div>
</div>

<script>
// Interactive password toggle
(function() {
    var toggleBtn = document.getElementById('twings-toggle-pwd');
    var pwdInput = document.getElementById('password');
    var eyeIcon = document.getElementById('twings-eye-icon');
    if (toggleBtn && pwdInput && eyeIcon) {
        toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                pwdInput.type = 'password';
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        });
    }
})();
</script>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}
