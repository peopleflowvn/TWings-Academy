{{!
    This file is part of TWings Academy Moodle theme.
    @template theme_twings/login
    Login page template for TWings Academy LMS without clutter footer.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="twings-login-page-wrapper">
    {{{ output.standard_top_of_body_html }}}
    <div id="page" class="mt-0">
        {{> core/login_layout }}
    </div>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
